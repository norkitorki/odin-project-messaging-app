path = request.format.json? ? param_to_dig_path(params[:props_at]) : nil

json.data(dig: path) do
  yield json
  if user_signed_in?
    json.currentUser do
      json.username current_user.username
      json.pub_id current_user.pub_id
      json.contacts current_user.contacts
    end

    json.signOutForm do
      form_props(url: destroy_user_session_path, method: :delete) do |f|
        f.submit "Log Out"
      end
    end

    json.deleteUserForm do
      form_props(url: destroy_user_path, method: :delete) do |f|
        f.submit "Delete User"
      end
    end
  end
end

json.componentIdentifier active_template_virtual_path
json.defers json.deferred!
json.fragments json.fragments!
json.assets [ asset_path('/app/javascript/entrypoints/application.jsx') ]

if protect_against_forgery?
  json.csrfToken form_authenticity_token
end

if path
  json.action 'graft'
  json.path params[:props_at]
end

json.restoreStrategy 'fromCacheAndRevisitInBackground'

json.renderedAt Time.now.to_i

json.slices do
  json.flash flash.to_h
end
