json.chat @chat

if @chat["private"] && current_user.pub_id == @chat[:admin][:pub_id]
  json.chatRequestForm do
    form_props(url: add_request_path, method: :post) do |f|
      f.hidden_field :chatId, value: @chat["pub_id"], name: :chat_id, id: nil
      f.hidden_field :requestType, value: "chat", id: nil
      f.text_field :receiver
      f.submit "Invite To Chat"
    end
  end
end

json.addMessageForm do
  form_props(url: add_message_path, method: :post) do |f|
    f.text_area :message
    f.file_field :images, multiple: true, accept: Message::IMAGE_CONTENT_TYPES.join(',')
    f.submit "Send"
  end
end

json.editMessageForm do
  form_props(url: update_message_path, method: :patch)
end

json.joinChatForm do
  form_props(url: join_chat_path, method: :post) do |f|
    f.submit "Join Chat"
  end
end

json.deleteChatForm do
  form_props(url: delete_chat_path, method: :delete) do |f|
    f.submit "Delete Chat"
  end
end

json.leaveChatForm do
  form_props(url: leave_chat_path, method: :delete) do |f|
    f.submit "Leave Chat"
  end
end