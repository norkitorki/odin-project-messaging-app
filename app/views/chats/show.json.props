json.chat @chat
json.userIsMember @user_is_member
json.messageQuery params[:m]
json.parentQuery params[:p]
json.messageReplies @replies

json.messages do
  json.data @messages
  json.pages @pages
end

if user_signed_in?
  json.forms do
    if @chat["private"] && current_user.pub_id == @chat[:admin][:pub_id]
      json.chatRequestForm do
        form_props(url: add_request_path, method: :post) do |f|
          f.hidden_field :chatId, value: @chat["pub_id"], name: :chat_id, id: nil
          f.hidden_field :requestType, name: :request_type, value: "chat", id: nil
          f.text_field :receiver
          f.submit "Invite To Chat"
        end
      end
    end

    if current_user.pub_id == @chat[:admin][:pub_id]
      json.deleteChatForm do
        form_props(url: delete_chat_path, method: :delete) do |f|
          f.hidden_field :chatId, value: @chat["pub_id"], name: :chat_id, id: nil
          f.submit "Delete Chat"
        end
      end
    end

    json.addMessageForm do
      form_props(url: add_message_path, method: :post) do |f|
        f.hidden_field :chatId, value: @chat["pub_id"], name: :chat_id, id: nil
        f.hidden_field :parentId, name: "message[parent_id]", id: nil
        f.text_area :value, name: "message[value]", autofocus: true
        f.file_field :images, name: "message[images][]", multiple: true, accept: Message::IMAGE_CONTENT_TYPES.join(',')
        f.submit "Send"
      end
    end

    json.editMessageForm do
      form_props(url: update_message_path, method: :patch) do |f|
        f.hidden_field :messageId, name: :message_id, id: nil
        f.text_area :value, name: "message[value]", id: :edit_value
        f.check_box :images, name: "message[images][]", id: nil
        f.submit "Update Message"
      end
    end

    json.deleteMessageForm do
      form_props(url: update_message_path, method: :patch) do |f|
        f.hidden_field :messageId, name: :message_id, id: nil
        f.hidden_field :destroy, value: true, id: nil
      end
    end

    json.joinChatForm do
      form_props(url: join_chat_path, method: :post) do |f|
        f.hidden_field :chatId, value: @chat["pub_id"], name: :chat_id, id: nil
        f.submit "Join"
      end
    end

    json.leaveChatForm do
      form_props(url: leave_chat_path, method: :delete) do |f|
        f.hidden_field :chatId, value: @chat["pub_id"], name: :chat_id, id: nil
        f.submit "Leave Chat"
      end
    end
  end
end
