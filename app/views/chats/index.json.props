json.chats current_user.chats.includes(:users, messages: [:user]).map { |c| { pub_id: c.pub_id, name: c.name, users: c.users, messages: c.messages.map { |m| { pub_id: m.pub_id, value: m.value, user: m.user, created: "#{distance_of_time_in_words_to_now(m.created_at)} ago" } } } }

json.addMessageForm do
  form_props(url: add_message_path, method: :post) do |f|
    f.text_area :message
    f.submit "Send"
  end
end

json.editMessageForm do
  form_props(url: update_message_path, method: :patch)
end

json.deleteMessageForm do
  form_props(url: remove_message_path, method: :delete)
end

json.leaveChatForm do
  form_props(url: close_chat_path, method: :delete) do |f|
    f.submit "Leave Chat"
  end
end
