json.user current_user
json.chats @public_chats
json.privateChats @private_chats
json.updated params[:u]

json.forms do
  json.avatarForm do
    form_props(model: current_user, url: update_user_path, method: :put) do |f|
      f.hidden_field :form_action, value: :avatar_form, name: :form_action, id: nil
      f.file_field :avatar, accept: User::IMAGE_CONTENT_TYPES.join(','), autofocus: true
      f.password_field :password, autocomplete: :password, id: :avatar_password
      f.password_field :password_confirmation, autocomplete: :password_confirmation, id: :avatar_password_confirmation
      f.submit "Update Avatar"
    end
    json.errors @errors ? @errors[:avatar_form] : nil
  end

  json.deleteAvatarForm do 
    form_props(url: delete_avatar_path, method: :delete) do |f|
      f.submit "Delete Avatar"
    end
  end

  json.editPasswordForm do
    form_props(model: current_user, url: update_user_path, method: :put) do |f|
      f.hidden_field :form_action, value: :password_form, name: :form_action, id: nil
      f.password_field :password, autocomplete: :password, autofocus: true
      f.password_field :password_confirmation, autocomplete: :password_confirmation
      f.password_field :current_password, autocomplete: :current_password
      f.submit "Update Password"
    end
    json.errors @errors ? @errors[:password_form] : nil
  end

  json.deleteUserForm do
    form_props(url: destroy_user_path, method: :delete) do |f|
      f.submit "Delete User"
    end
  end
end
