json.user @user
json.chatCount @user.chats.where(private: false).count
json.messageCount @user.messages.count

if user_signed_in?
  json.userIsContact current_user.contacts.include?(@user)
  json.friendRequestForm do
    form_props(url: add_request_path, method: :post) do |f|
      f.hidden_field :requestType, name: :request_type, value: "friend", id: nil
      f.hidden_field :receiver, id: nil
      f.submit "Send Friend Request"
    end
  end

  json.removeContactForm do
    form_props(url: remove_contact_path, method: :delete) do |f|
      f.hidden_field :userId, name: :user_id, id: nil
      f.submit "Remove Contact"
    end
  end
end
