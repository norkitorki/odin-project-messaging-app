json.newUserForm do
  form_props(model: @user, url: user_registration_path) do |f|
    f.text_field(:username)
    f.password_field(:password)
    f.password_field(:passwordConfirmation, name: "user[password_confirmation]")
    f.submit "Sign Up"
  end
end

json.formErrors @user.errors.to_hash(true)
